	column 'Is Weekend'
		formatString: """TRUE"";""TRUE"";""FALSE"""
		lineageTag: 13f88cfd-3583-4ce9-a9ba-883d59198772
		summarizeBy: none
		isNameInferred
		sourceColumn: [Is Weekend]

		annotation SummarizationSetBy = Automatic

	partition DIM_Date = calculated
		mode: import
		source =
				
				VAR MinDate = DATE ( YEAR ( MIN ( FACT_Orders[order_purchase_timestamp] ) ), 1, 1 )
				VAR MaxDate = DATE ( YEAR ( MAX ( FACT_Orders[order_purchase_timestamp] ) ), 12, 31 )
				RETURN
				ADDCOLUMNS (
				    CALENDAR ( MinDate, MaxDate ),
				    "Year", YEAR ( [Date] ),
				    "Quarter", "Q" & QUARTER ( [Date] ),
				    "Month Number", MONTH ( [Date] ),
				    "Month Name", FORMAT ( [Date], "MMM" ),
				    "Year-Month", FORMAT ( [Date], "YYYY-MM" ),
				    "Year-Month Sort", YEAR ( [Date] ) * 100 + MONTH ( [Date] ),
				    "Day of Week Number", WEEKDAY ( [Date], 2 ),
				    "Day Name", FORMAT ( [Date], "ddd" ),
				    "Is Weekend", IF ( WEEKDAY ( [Date], 2 ) > 5, TRUE (), FALSE () )
				)

	annotation PBI_Id = 57634e3f13c44edcbde63e4c34f58c4f

